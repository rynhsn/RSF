@inherits R_Page
@attribute [R_Page(ResourceId = "_Location")]
@inject R_ILocalizer<Lookup_GSFrontResources.Resources_Dummy_Class> _localizer
@using Lookup_GSCOMMON.DTOs

<R_StackLayout Style="width: 800px">
    <R_StackLayout Row Class="justify-content-between">
        <R_ItemLayout>
            <R_Label>@_localizer["_Property"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="8">
            <R_ComboBox Data="@_viewModel.PropertyList"
                        Value="@_viewModel.LookupParam.CPROPERTY_ID" 
                        ValueField="@(nameof(GSLPropertyDTO.CPROPERTY_ID))"
                        TextField="@(nameof(GSLPropertyDTO.CPROPERTY_NAME))"
                        ValueChanged="@((string value) => OnChangePropertyComboBox(value))"
                        Enabled="@(EnableLookupList)"></R_ComboBox>
        </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row>
        <R_Grid @ref="@GridRef"
                DataSource="_viewModel.LocationGrid"
                R_GridType="@R_eGridType.Navigator"
                R_ServiceGetListRecord="R_ServiceGetListRecordAsync"
                Height="300px"
                Pageable="true"
                Enabled="@(_viewModel.PropertyList.Count > 0)">
            <R_GridColumns>
                <R_GridTextColumn FieldName="@nameof(GSL03800DTO.CLOCATION_ID)" HeaderText="@_localizer["_LocationID"]" Width="130px"></R_GridTextColumn>
                <R_GridTextColumn FieldName="@nameof(GSL03800DTO.CLOCATION_NAME)" HeaderText="@_localizer["_LocationName"]" Width="160px"></R_GridTextColumn>
                <R_GridTextColumn FieldName="@nameof(GSL03800DTO.CBUILDING_NAME)" HeaderText="@_localizer["_Building"]" Width="140px"></R_GridTextColumn>
                <R_GridTextColumn FieldName="@nameof(GSL03800DTO.CFLOOR_NAME)" HeaderText="@_localizer["_Floor"]" Width="140px"></R_GridTextColumn>
                <R_GridCheckBoxColumn FieldName="@nameof(GSL03800DTO.LACTIVE)" HeaderText="@_localizer["_Active"]" Width="90px"></R_GridCheckBoxColumn>
            </R_GridColumns>
        </R_Grid>
    </R_StackLayout>

    <R_StackLayout Row Class="justify-content-between"> 
        <R_ItemLayout>
            <R_CheckBox Value="@_viewModel.LACTIVE_CHECKBOX"
                        ValueChanged="@((bool value) => OnChangeInactiveLocation(value))"
                        Enabled="@(_viewModel.PropertyList.Count > 0)">
            </R_CheckBox>
            <R_Label>@_localizer["_IncludeInactiveLocation"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button OnClick="Button_OnClickOkAsync" Enabled="@(_viewModel.PropertyList.Count > 0)">
                @_localizer["_OkBtn"]
            </R_Button>
            <R_Button OnClick="Button_OnClickCloseAsync">
                @_localizer["_CancelBtn"]
            </R_Button>
        </R_ItemLayout>
    </R_StackLayout>
</R_StackLayout>
