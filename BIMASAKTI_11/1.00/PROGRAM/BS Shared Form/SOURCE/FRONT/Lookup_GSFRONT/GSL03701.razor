@inherits R_Page
@attribute [R_Page(ResourceId = "_ViewMessage")]
@inject R_ILocalizer<Lookup_GSFrontResources.Resources_Dummy_Class> _localizer
@using Lookup_GSCOMMON.DTOs

<R_StackLayout Style="width: 800px">
    <R_StackLayout Row>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_Message"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="6">
            <R_TextBox @bind-Value="@loData.CMESSAGE_NO_NAME"
                       Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="3">
            <R_TextBox @bind-Value="@loData.CMESSAGE_TYPE_DESCR"
                       Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_Desc"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="9">
            <R_TextEditor @bind-Value="@loData.TMESSAGE_DESCRIPTION"
                          Height="125px"
                          R_TextEditorToolMode="R_eTextEditorToolMode.None"
                          ReadOnly="true" />
        </R_ItemLayout>
    </R_StackLayout>
    <R_StackLayout Row>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_AdditionalInfo"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="9">
            <R_TextEditor @bind-Value="@loData.CADDITIONAL_DESCRIPTION"
                          Height="125px"
                          R_TextEditorToolMode="R_eTextEditorToolMode.None"
                          ReadOnly="true" />
        </R_ItemLayout>
    </R_StackLayout>

</R_StackLayout>