@inherits R_Page
@* Asset List Component - Displays asset grid and detail form *@

<R_StackLayout>
    <!-- Top Section: Asset List Grid -->
    <R_ItemLayout col="12" class="mt-3">
        <R_StackLayout Row class="mb-1">
            <R_ItemLayout col="2">
                <R_Label>@Localizer["_Reference"]</R_Label>
            </R_ItemLayout>
            <R_ItemLayout col="3">
                <R_Label>@(VM?.CurrentRecord?.CREF_NO ?? string.Empty)</R_Label>
            </R_ItemLayout>
            <R_ItemLayout col="3">
                <R_Label>@(VM?.CurrentRecord?.CREF_DATE_DISPLAY ?? string.Empty)</R_Label>
            </R_ItemLayout>
        </R_StackLayout>
        <R_StackLayout Row class="mb-1">
            <R_ItemLayout col="2">
                <R_Label>@Localizer["_Supplier"]</R_Label>
            </R_ItemLayout>
            <R_ItemLayout col="6">
                <R_Label>@(VM?.CurrentRecord?.CSUPPLIER_ID ?? string.Empty) @(VM?.CurrentRecord?.CSUPPLIER_NAME ?? string.Empty)</R_Label>
            </R_ItemLayout>
        </R_StackLayout>
    </R_ItemLayout>
    
    <R_ItemLayout col="12" class="mb-3">
        <R_Grid @ref="_gridRef"
                DataSource="@(VM.AssetList ?? new System.Collections.ObjectModel.ObservableCollection<FAT00100GetTransAssetListResultDTO>())"
                Pageable
                PageSize="20"
                R_ConductorSource="@_conductorRef"
                R_GridType="@R_eGridType.Navigator"
                R_ServiceGetListRecord="@Grid_R_ServiceGetListRecord"
                
                Height="300px">
            <R_GridColumns>
                <R_GridTextColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.CASSET_CODE)" 
                                 HeaderText="@Localizer["_AssetCode"]" 
                                 Width="150px" />
                <R_GridTextColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.CASSET_NAME)" 
                                 HeaderText="@Localizer["_AssetName"]" 
                                 Width="200px" />
                <R_GridTextColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.CCURRENCY_CODE)"
                                  HeaderText="@Localizer["_Curr"]"
                                  Width="100px" />
                <R_GridNumericColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.NLINIT_COST)" 
                                    HeaderText="@Localizer["_InitialCost"]" 
                                    Width="120px"
                                    TValue="decimal"
                                    Decimals="2"
                                    ThousandSeparator="true" />
                <R_GridNumericColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.IQTY)" 
                                    HeaderText="@Localizer["_Quantity"]" 
                                    Width="100px"
                                    TValue="int"
                                    ThousandSeparator="false" />
                <R_GridTextColumn FieldName="@nameof(FAT00100GetTransAssetListResultDTO.CUNIT)" 
                                 HeaderText="@Localizer["_Unit"]" 
                                 Width="80px" />
            </R_GridColumns>
        </R_Grid>
    </R_ItemLayout>

    <!-- Bottom Section: Asset Detail Form -->
    <R_ItemLayout col="12" >
        <R_GroupBox Title="@Localizer["_AssetDetails"]" class="ps-1">
            <R_StackLayout>
                <!-- Asset Department -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_AssetDepartment"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="VM.Data.CASSET_DEPT_CODE" 
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="VM.Data.CASSET_DEPT_NAME" 
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                @* Asset Category - Not available in FAT00100GetTransAssetListResultDTO *@
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_AssetCategory"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="VM.Data.CCATEGORY_CODE"
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="VM.Data.CCATEGORY_NAME"
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Location -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_Location"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="VM.Data.CLOCATION_NAME" 
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Serial Number -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_SerialNumber"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="VM.Data.CSERIAL_NUMBER" 
                                   R_ConductorSource="@_conductorRef"
                                   Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Local Amount -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_LocalAmount"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox Value="@VM.Data.CLOCAL_CURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox @bind-Value="VM.Data.NLOCAL_AMOUNT"
                                         TValue="decimal"
                                         Decimals="2"
                                         ThousandSeparator="true"
                                          Arrows="false"
                                         R_ConductorSource="@_conductorRef"
                                         Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Base Amount -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_BaseAmount"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox Value="@VM.Data.CBASE_CURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox @bind-Value="VM.Data.NBASE_AMOUNT"
                                         TValue="decimal"
                                         Decimals="2"
                                         ThousandSeparator="true"
                                          Arrows="false"
                                         R_ConductorSource="@_conductorRef"
                                         Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>
            </R_StackLayout>
        </R_GroupBox>
    </R_ItemLayout>
</R_StackLayout>

<R_Conductor @ref="_conductorRef"
             R_ViewModel="@VM"
             R_IsHeader="true"
             R_ServiceGetRecord="@Conductor_R_ServiceGetRecord" />

