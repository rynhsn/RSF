@page "/FAT00100"
@inherits R_Page

<R_StackLayout Row class="mb-2">
    <R_ItemLayout col="5">
        <R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout col="3">
                    <R_Label>@Localizer["_Department"]*</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_TextBox @bind-Value="_VM.PoDeptCode" 
                               OnLostFocused="txtDepartmentCode_OnLostFocused" 
                               MaxLength="20" />
                </R_ItemLayout>
                <R_ItemLayout auto="true">
                    <R_Lookup R_Before_Open_Lookup="btnDepartmentLookup_R_Before_Open_Lookup"
                              R_After_Open_Lookup="btnDepartmentLookup_R_After_Open_Lookup">...</R_Lookup>
                </R_ItemLayout>
                <R_ItemLayout auto="false">
                    <R_TextBox @bind-Value="_VM.PoDeptName" Enabled="false" />
                </R_ItemLayout>
            </R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout col="3">
                    <R_Label>@Localizer["_Supplier"]</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_TextBox @bind-Value="_VM.PoSupplierId" 
                               OnLostFocused="txtSupplierCode_OnLostFocused" 
                               MaxLength="20" />
                </R_ItemLayout>
                <R_ItemLayout auto="true">
                    <R_Lookup R_Before_Open_Lookup="btnSupplierLookup_R_Before_Open_Lookup"
                              R_After_Open_Lookup="btnSupplierLookup_R_After_Open_Lookup">...</R_Lookup>
                </R_ItemLayout>
                <R_ItemLayout auto="false">
                    <R_TextBox @bind-Value="_VM.PoSupplierName" Enabled="false" />
                </R_ItemLayout>
            </R_StackLayout>
        </R_StackLayout>
    </R_ItemLayout>

    <R_ItemLayout col="7" class="ms-6">
        <R_StackLayout>
            <R_StackLayout Row>
                <R_ItemLayout auto="true" class="pe-3">
                    <R_Label>@Localizer["_Period"]</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_NumericTextBox @bind-Value="_VM.PeriodFromYear"
                                     Arrows="true"
                                     TValue="int"
                                     Min="_VM.YearRangeData.IMIN_YEAR"
                                     Max="_VM.YearRangeData.IMAX_YEAR"
                                     Step="1"
                                     ThousandSeparator="false" />
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_ComboBox @bind-Value="_VM.PeriodFromMonth"
                                Data="_VM.ComboPeriodMonthList"
                               ValueField="@nameof(FAT00100GetComboPeriodMonthResultDTO.CPERIOD_NO)"
                               TextField="@nameof(FAT00100GetComboPeriodMonthResultDTO.CPERIOD_NO)" />
                </R_ItemLayout>
                <R_Label>-</R_Label>
                <R_ItemLayout col="2">
                    <R_NumericTextBox @bind-Value="_VM.PeriodToYear"
                                     Arrows="true"
                                     TValue="int"
                                    Min="_VM.YearRangeData.IMIN_YEAR"
                                    Max="_VM.YearRangeData.IMAX_YEAR"
                                    Step="1"
                                    ThousandSeparator="false" />
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_ComboBox @bind-Value="_VM.PeriodToMonth"
                               Data="_VM.ComboPeriodMonthList"
                               ValueField="@nameof(FAT00100GetComboPeriodMonthResultDTO.CPERIOD_NO)"
                               TextField="@nameof(FAT00100GetComboPeriodMonthResultDTO.CPERIOD_NO)" />
                </R_ItemLayout>
            </R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout auto="true" class="pe-3">
                    <R_Label>@Localizer["_Status"]</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_ComboBox @bind-Value="_VM.SelectedStatus"
                               Data="_VM.StatusList"
                               ValueField="@nameof(FAT00100GetStatusListResultDTO.CCODE)"
                               TextField="@nameof(FAT00100GetStatusListResultDTO.CNAME)" />
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_Button OnClick="btnRefresh_OnClick">@Localizer["_Refresh"]</R_Button>
                </R_ItemLayout>
            </R_StackLayout>
        </R_StackLayout>
    </R_ItemLayout>
</R_StackLayout>

<R_StackLayout Row>
    <R_ItemLayout col="4">
        <R_Grid @ref="_gridRef"
                DataSource="@_VM.DataGridList"
                Pageable
                PageSize="20"
                R_ConductorSource="@_conductorRef"
                R_GridType="@R_eGridType.Navigator"
                R_ServiceGetListRecord="@Grid_R_ServiceGetListRecord"
                R_Display="@Grid_R_Display"
                Height="457px">
            <R_GridColumns>
                <R_GridTextColumn FieldName="@nameof(FAT00100GetDataGridResultDTO.CREF_NO)" 
                                 HeaderText="@Localizer["_ReferenceNo"]" 
                                 Width="120px" />
                @* <R_GridTextColumn FieldName="@nameof(FAT00100GetDataGridResultDTO.CREF_DATE_DISPLAY)" *@
                @*                   HeaderText="@Localizer["_Date"]"  *@
                @*                  Width="100px" /> *@
                <R_GridDatePickerColumn FieldName="@nameof(FAT00100GetDataGridResultDTO.DREF_DATE)"
                                  HeaderText="@Localizer["_Date"]"
                                  Width="100px" />
                <R_GridTextColumn FieldName="@nameof(FAT00100GetDataGridResultDTO.CTRANS_STATUS_NAME)" 
                                 HeaderText="@Localizer["_Status"]" 
                                 Width="100px" />                 
                <R_GridTextColumn FieldName="@nameof(FAT00100GetDataGridResultDTO.CSUPPLIER_NAME)" 
                                 HeaderText="@Localizer["_Supplier"]" 
                                 Width="200px" />
                
            </R_GridColumns>
        </R_Grid>
    </R_ItemLayout>
    <R_ItemLayout col="8">
        <!-- Detail Form Section (Displayed when grid row is selected) -->
        <R_TabStrip @ref="_tabStripRef" OnActiveTabIndexChanged="onActivetab">
            <R_TabStripTab Title="@Localizer["rpvAcqEntry"]" Id="@nameof(FAT00100)">

                <!-- Header Information Section -->
                <!-- Row 1: Department (left) | Reference No (right) -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_Department"]*</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_VM.Data.CDEPT_CODE"
                                R_ConductorSource="@_conductorRef"
                                Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Add)"
                                   OnLostFocused="txtDepartmentCodeEntry_OnLostFocused" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Lookup R_Before_Open_Lookup="btnDepartmentEntryLookup_R_Before_Open_Lookup"
                                R_After_Open_Lookup="btnDepartmentEntryLookup_R_After_Open_Lookup" Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Add)" >...</R_Lookup>
                    </R_ItemLayout>
                    
                    <R_ItemLayout auto="true">
                        <R_TextBox @bind-Value="_VM.Data.CDEPT_NAME" Enabled="false" />
                    </R_ItemLayout>

                    <R_ItemLayout col="2">
                        <R_Label FontColor="R_eFontColor.Primary">
                            @_VM.Data.CTRANS_STATUS_NAME
                        </R_Label>
                    </R_ItemLayout>
                    
                </R_StackLayout>

                <!-- Row 2: Ref. Date (left) | Document No (right) -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_ReferenceNo"]@(_VM.TransCodeInfoData.LINCREMENT_FLAG == false?"*":"")</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CREF_NO"
                                R_ConductorSource="@_conductorRef"
                                MaxLength="30"
                                Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.TransCodeInfoData != null && _VM.TransCodeInfoData.LINCREMENT_FLAG == false)" />

                    </R_ItemLayout>
                    <R_ItemLayout col="3" class="ps-4">
                        <R_Label>@Localizer["_RefDate"]*</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_DatePicker @bind-Value="_VM.Data.DREF_DATE"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableAdd="true"
                                    R_EnableEdit="true" />
                    </R_ItemLayout>
                    
                </R_StackLayout>

                <!-- Row 3: Doc. Date (left) -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_DocumentNumber"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CDOCUMENT_NO"
                                R_ConductorSource="@_conductorRef"
                                R_EnableAdd="true"
                                R_EnableEdit="true" />
                    </R_ItemLayout>
                    <R_ItemLayout col="3" class="ps-4">
                        <R_Label>@Localizer["_DocDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_DatePicker @bind-Value="_VM.Data.DDOCUMENT_DATE"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableAdd="true"
                                    R_EnableEdit="true" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Source and Transaction Section -->
                <!-- Source Radio Buttons -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_Source"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_RadioGroup Data="SourceList"
                                      Value="_VM.Data.CSOURCE_MODULE"
                                    ValueChanged="@((string value) => OnSourceChanged(value))"
                                    ValueField="@nameof(SourceOptionDTO.CVALUE)"
                                    TextField="@nameof(SourceOptionDTO.CDESCRIPTION)"
                                    R_ConductorSource="@_conductorRef"
                                     Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                

                <!-- Transaction Number for PJ Row -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_SourceRefNo"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CFR_REF_NO"
                                R_ConductorSource="@_conductorRef"
                                   R_EnableAdd="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   R_EnableEdit="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal &&_VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Lookup R_Before_Open_Lookup="btnPJTransactionLookup_R_Before_Open_Lookup"
                                R_After_Open_Lookup="btnPJTransactionLookup_R_After_Open_Lookup"
                                  Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)">...</R_Lookup>
                    </R_ItemLayout>
                </R_StackLayout>
                <!-- FR Deparment  -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_SourceDepartment"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CFR_DEPT_CODE"
                                R_ConductorSource="@_conductorRef"
                                   R_EnableAdd="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal &&_VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   R_EnableEdit="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal &&_VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Lookup R_Before_Open_Lookup="btnFRDepartmentLookup_R_Before_Open_Lookup"
                                R_After_Open_Lookup="btnFRDepartmentLookup_R_After_Open_Lookup"
                                  Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)">...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="_VM.Data.CFR_DEPT_NAME" Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>
                <!-- FR Transaction Type Row -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_SourceTrans"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CFR_TRANS_CODE"
                                R_ConductorSource="@_conductorRef"
                                   R_EnableAdd="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   R_EnableEdit="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)"
                                   Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Lookup R_Before_Open_Lookup="btnTransactionTypeLookup_R_Before_Open_Lookup"
                                R_After_Open_Lookup="btnTransactionTypeLookup_R_After_Open_Lookup"
                                  Enabled="@(_VM.Data.CSOURCE_MODULE == FAT00100ViewModel.DEFAULT_SOURCE_MODULE_PJ)">...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="_VM.Data.CFR_TRANS_NAME" Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                

                <!-- Supplier Section -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_Supplier"]*</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_TextBox @bind-Value="_VM.Data.CSUPPLIER_ID"
                                R_ConductorSource="@_conductorRef"
                                R_EnableAdd="true"
                                R_EnableEdit="true"
                                OnLostFocused="txtSupplierCodeEntry_OnLostFocused" 
                                Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Add)" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Lookup R_Before_Open_Lookup="btnSupplierEntryLookup_R_Before_Open_Lookup"
                                R_After_Open_Lookup="btnSupplierEntryLookup_R_After_Open_Lookup"
                                  R_ConductorSource="@_conductorRef" Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Add)" >...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout auto="false">
                        <R_TextBox @bind-Value="_VM.Data.CSUPPLIER_NAME" Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Currency and Rates Section -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_Currency"]*</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_ComboBox Value="_VM.Data.CCURRENCY_CODE"
                                    Data="_VM.CurrencyList"
                                    ValueChanged="@((string value) => _valueChangedCurrency(value))"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableAdd="true"
                                    R_EnableEdit="true"
                                    ValueField="@nameof(FAT00100GetCurrencyListResultDTO.CCURRENCY_CODE)"
                                    TextField="@nameof(FAT00100GetCurrencyListResultDTO.CCURRENCY_NAME)" />
                    </R_ItemLayout>

                </R_StackLayout>

                <!-- Currency Rate Section -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_CurrencyRate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_LocalCurrency"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox @bind-Value="_VM.Data.NLBASE_RATE"
                                        TValue="decimal"
                                        Decimals="2"
                                        ThousandSeparator="true"
                                         Arrows="false"
                                        R_ConductorSource="@_conductorRef"
                                        Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.CompanyInfoData != null && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
                    </R_ItemLayout>
                    <R_ItemLayout col="1">
                        <R_TextBox @bind-Value="_VM.Data.CCURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Label>=</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox @bind-Value="_VM.Data.NLCURRENCY_RATE"
                                        TValue="decimal"
                                        Decimals="2"
                                        ThousandSeparator="true"
                                          Arrows="false"
                                        R_ConductorSource="@_conductorRef"
                                        Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.CompanyInfoData != null && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
                    </R_ItemLayout>
                    <R_ItemLayout col="1">
                        <R_TextBox @bind-Value="_VM.Data.CLOCAL_CURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3"></R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_BaseCurrency"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox @bind-Value="_VM.Data.NBBASE_RATE"
                                        TValue="decimal"
                                        Decimals="2"
                                        ThousandSeparator="true"
                                          Arrows="false"
                                        R_ConductorSource="@_conductorRef"
                                        Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.CompanyInfoData != null && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
                    </R_ItemLayout>
                    <R_ItemLayout col="1">
                        <R_TextBox @bind-Value="_VM.Data.CCURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout auto="true">
                        <R_Label>=</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox @bind-Value="_VM.Data.NBCURRENCY_RATE"
                                        TValue="decimal"
                                        Decimals="2"
                                        ThousandSeparator="true"
                                          Arrows="false"
                                        R_ConductorSource="@_conductorRef"
                                        Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.CompanyInfoData != null && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
                    </R_ItemLayout>
                    <R_ItemLayout col="1">
                        <R_TextBox @bind-Value="_VM.Data.CBASE_CURRENCY_CODE" Enabled="false" />
                    </R_ItemLayout>
                </R_StackLayout>

                <!-- Description Section -->
                <R_StackLayout Row class="mb-1">
                    <R_ItemLayout col="3">
                        <R_Label>@Localizer["_Description"]*</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="9">
                        <R_TextArea @bind-Value="_VM.Data.CTRANS_DESC"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableAdd="true"
                                    R_EnableEdit="true"
                                    Rows="3" />
                    </R_ItemLayout>
                </R_StackLayout>



                <!-- Audit Trail Section -->
                <R_StackLayout Row class="d-flex justify-content-end mb-1">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_Updated"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_VM.Data.CUPDATE_BY" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_DateTimePicker R_ConductorSource="_conductorRef" Enabled="false" @bind-value="_VM.Data.DUPDATE_DATE">
                        </R_DateTimePicker>
                    </R_ItemLayout>
                </R_StackLayout>
                <R_StackLayout Row class="d-flex justify-content-end">
                    <R_ItemLayout col="2">
                        <R_Label>@Localizer["_Created"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_VM.Data.CCREATE_BY" Enabled="false" />
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_DateTimePicker R_ConductorSource="_conductorRef" Enabled="false" @bind-value="_VM.Data.DCREATE_DATE">
                        </R_DateTimePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                
            </R_TabStripTab>

            <!-- Tab 2: Asset List -->
            <R_TabStripTab @ref="_tabAssetList" Title="@Localizer["rpvAssetList"]" Id="@nameof(FAT00100AssetList)"> 
                 <R_TabPage @ref="_tabPageAssetList" R_Before_Open_TabPage="BeforeOpenAssetList" R_After_Open_TabPage="AfterOpenAssetList" R_TabEventCallback="AssetListTabEventCallBack"/>
            </R_TabStripTab>
        </R_TabStrip>
    </R_ItemLayout>
</R_StackLayout>
<!-- button CRUD Actions -->
<R_StackLayout Row class="justify-content-between mt-2">
    <!-- Left Button Group -->
    <R_StackLayout Row>
        <R_ItemLayout>
            <R_AddButton R_Conductor="@_conductorRef" Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && enableButton==true )" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_EditButton R_Conductor="@_conductorRef" 
                          Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && _VM.Data?.CTRANS_STATUS == "00" && enableButton==true )" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_DeleteButton R_Conductor="@_conductorRef" 
                            Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && enableButton==true && (_VM.Data?.CTRANS_STATUS == "00" || _VM.Data?.CTRANS_STATUS == "08"))" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button R_ConductorSource="@_conductorRef"
                      R_EnableOther
                      OnClick="@btnDetail_OnClick">
                @Localizer["_Detail"]
            </R_Button>
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button R_ConductorSource="@_conductorRef" 
                    R_EnableOther="true"
                      Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && enableButton==true && !string.IsNullOrEmpty(_VM.Data.CREF_NO) && _VM.Data.CTRANS_STATUS == "00")"
                    OnClick="btnSubmit_OnClick">
                @Localizer["_Submit"]
            </R_Button>
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button R_ConductorSource="@_conductorRef" 
                    R_EnableOther="true"
                      Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && enableButton==true && !string.IsNullOrEmpty(_VM.Data.CREF_NO) && _VM.Data.CTRANS_STATUS == "10")"
                    OnClick="btnRedraft_OnClick">
                @Localizer["_Draft"]
            </R_Button>
        </R_ItemLayout>

        @* <R_ItemLayout> *@
        @*     <R_Button R_ConductorSource="@_conductorRef"  *@
        @*             R_EnableOther="true" *@
        @*             Enabled="@(!string.IsNullOrEmpty(_VM.Data.CREF_NO))" *@
        @*             OnClick="btnPrint_OnClick"> *@
        @*         @Localizer["_Print"] *@
        @*     </R_Button> *@
        @* </R_ItemLayout> *@

        <R_ItemLayout>
            <R_Popup R_ConductorSource="@_conductorRef" Enabled="@(_conductorRef?.R_ConductorMode == R_eConductorMode.Normal && _VM.Data?.CTRANS_STATUS != null && int.TryParse(_VM.Data.CTRANS_STATUS, out int liStatus) && liStatus > 0 && !string.IsNullOrEmpty(_VM.Data?.CGL_REF_NO))" R_Before_Open_Popup="R_Before_Open_PopupJournal">@Localizer["_Journal"]</R_Popup>
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Right Button Group -->
    <R_StackLayout Row>
        <R_ItemLayout>
            <R_CancelButton R_Conductor="@_conductorRef" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_SaveButton R_Conductor="@_conductorRef" />
        </R_ItemLayout>
    </R_StackLayout>
</R_StackLayout>

<R_ConductorGrid @ref="_conductorGridRef"
                 R_IsHeader />

<!-- R_Conductor Component  -->
<R_Conductor @ref="_conductorRef"
             R_ViewModel="@_VM"
             R_IsHeader="true"
             R_DisableDeleteConfirmation="true"
             R_ServiceGetRecord="@Conductor_R_ServiceGetRecord"
             R_Display="@Conductor_R_Display"
