@page "/FAT00301"
@inherits R_Page
@using FAT00300Common.DTOs;
@using FAT00300Common.Requests;

<R_TabStrip @ref="@_tabStripRef">

    @* Tab Transaction Entry *@
    <R_TabStripTab Title="@Localizer["_tabTransactionEntry"]"
                   Id="FAT00301">

        @* Department Lookup - Status Trans *@
        <R_StackLayout>
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblDeptM"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox R_ConductorSource="@_conTransEntry"
                                       R_EnableAdd
                                       OnLostFocused="@OnLostFocusedDepartment"
                                       @bind-value="@ViewModelFAT00301.Data.CDEPT_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_Lookup R_ConductorSource="@_conTransEntry"
                                  R_EnableAdd
                                  R_Before_Open_Lookup="@BeforeOpenLookUpDepartment"
                                  R_After_Open_Lookup="@AfterOpenLookUpDepartment">
                            ...
                        </R_Lookup>

                        <R_ItemLayout col="5">
                            <R_TextBox R_ConductorSource="@_conTransEntry"
                                       @bind-value="@ViewModelFAT00301.Data.CDEPT_NAME"
                                       Enabled="false">
                            </R_TextBox>
                        </R_ItemLayout>

                        <h5 class="text-primary">
                            @ViewModelFAT00301.Data.CTRANS_STATUS_NAME
                        </h5>

                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Reference NO - Ref Date *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblRefM"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="3">
                            <R_TextBox R_ConductorSource="@_conTransEntry"
                                       R_EnableAdd
                                       Enabled="@((_conTransEntry.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Add) && ViewModelFAT00301.paramTranEntry.LINCREMENT_FLAG == false ? true : false)"
                                       @bind-value="@ViewModelFAT00301.Data.CREF_NO">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblRefDateM"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout auto="false">
                            <R_DatePicker R_ConductorSource="@_conTransEntry"
                                          R_EnableAdd
                                          R_EnableEdit
                                          Value="@ViewModelFAT00301.Data.DREF_DATE"
                                          ValueChanged="@((DateTime? pdValue) => @RefDateChanged(pdValue))">
                            </R_DatePicker>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Asset Code - Trans Seq No *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblAssetCodeM"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="2">
                            <R_TextBox R_ConductorSource="@_conTransEntry"
                                       R_EnableAdd
                                       OnLostFocused="@OnLostFocusedAsset"
                                       @bind-value="@ViewModelFAT00301.Data.CASSET_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_Lookup R_ConductorSource="@_conTransEntry"
                                  R_EnableAdd
                                  R_Before_Open_Lookup="@BeforeOpenLookUpAsset"
                                  R_After_Open_Lookup="@AfterOpenLookUpAsset">
                            ...
                        </R_Lookup>

                        <R_Label>
                            @Localizer["_lblTransSeqNo"]
                        </R_Label>

                        <R_ItemLayout auto="false">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.Data.CASSET_TRANS_SEQ_NO">
                            </R_TextBox>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Asset Name *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblAssetName"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout auto="false">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.Data.CASSET_NAME">
                            </R_TextBox>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Depr Quantity *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_gvDeprQtyM"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="2">
                            <R_NumericTextBox R_ConductorSource="@_conTransEntry"
                                              Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.IQTY"
                                              TValue="int">
                            </R_NumericTextBox>
                        </R_ItemLayout>
                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.Data.CUNIT">
                            </R_TextBox>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Depr Amount *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblDepr*"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox @bind-value="@ViewModelFAT00301.CDEPR_AMOUN_CURRENCY_CODE"
                                       Enabled="false">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="3">
                            <R_NumericTextBox R_ConductorSource="@_conTransEntry"
                                              R_EnableAdd
                                              R_EnableEdit
                                              Value="@ViewModelFAT00301.Data.NTRANS_AMOUNT"
                                              ValueChanged="@((decimal pnValue) => @DeprAmountChanged(pnValue))"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>

                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Currency Rate - Local Currency *@
            <R_StackLayout Row>
                <R_ItemLayout col="12">
                    <R_StackLayout Row>
                        <R_ItemLayout col="1">
                            <R_Label>
                                @Localizer["_lblCurRate"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_Label Style="margin-right: 0.85%">
                            @Localizer["_lblLocalCurrency"]
                        </R_Label>

                        <R_ItemLayout col="1">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NLBASE_RATE"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>
                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.Data.CCURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>
                        <R_Label>
                            =
                        </R_Label>

                        <R_ItemLayout col="1">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NLCURRENCY_RATE"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.paramTranEntry.CLOCAL_CURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_Label>
                                @Localizer["_lblLocalAmt"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.paramTranEntry.CLOCAL_CURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="2">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NLTRANS_AMOUNT"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Base Currency *@
            <R_StackLayout Row>
                <R_ItemLayout col="12">
                    <R_StackLayout Row>
                        <R_ItemLayout col="1">

                        </R_ItemLayout>

                        <R_Label Style="margin-right: 1%">
                            @Localizer["_lblBaseCurrency"]
                        </R_Label>

                        <R_ItemLayout col="1">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NBBASE_RATE"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>
                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.Data.CCURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>
                        <R_Label>
                            =
                        </R_Label>

                        <R_ItemLayout col="1">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NBCURRENCY_RATE"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.paramTranEntry.CBASE_CURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_Label>
                                @Localizer["_lblBaseAmt"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout col="1">
                            <R_TextBox Enabled="false"
                                       @bind-value="@ViewModelFAT00301.paramTranEntry.CBASE_CURRENCY_CODE">
                            </R_TextBox>
                        </R_ItemLayout>

                        <R_ItemLayout col="2">
                            <R_NumericTextBox Enabled="false"
                                              @bind-value="@ViewModelFAT00301.Data.NBTRANS_AMOUNT"
                                              TValue="decimal">
                            </R_NumericTextBox>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>

            @* Description *@
            <R_StackLayout Row>
                <R_ItemLayout col="6">
                    <R_StackLayout Row>
                        <R_ItemLayout col="2">
                            <R_Label>
                                @Localizer["_lblDescription"]
                            </R_Label>
                        </R_ItemLayout>

                        <R_ItemLayout auto="false">
                            <R_TextArea R_ConductorSource="@_conTransEntry"
                                        R_EnableAdd
                                        R_EnableEdit
                                        @bind-value="@ViewModelFAT00301.Data.CTRANS_DESC"
                                        Height="75px">
                            </R_TextArea>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>

                <R_ItemLayout col="8" Class="mt-2">
                    <R_StackLayout>
                        <R_StackLayout Row>
                            <R_ItemLayout col="1">
                                <R_Label>
                                    @Localizer["_lblUpdateby"]
                                </R_Label>
                            </R_ItemLayout>

                            <R_ItemLayout col="1">
                                <R_TextBox Enabled="false"
                                           @bind-value="@ViewModelFAT00301.Data.CUPDATE_BY">
                                </R_TextBox>
                            </R_ItemLayout>

                            <R_ItemLayout col="3">
                                <R_DateTimePicker Enabled="false"
                                                  @bind-value="@ViewModelFAT00301.Data.DUPDATE_DATE">
                                </R_DateTimePicker>
                            </R_ItemLayout>
                        </R_StackLayout>

                        <R_StackLayout Row>
                            <R_ItemLayout col="1">
                                <R_Label>
                                    @Localizer["_lblCreateby"]
                                </R_Label>
                            </R_ItemLayout>

                            <R_ItemLayout col="1">
                                <R_TextBox Enabled="false"
                                           @bind-value="@ViewModelFAT00301.Data.CCREATE_BY">
                                </R_TextBox>
                            </R_ItemLayout>

                            <R_ItemLayout col="3">
                                <R_DateTimePicker Enabled="false"
                                                  @bind-value="@ViewModelFAT00301.Data.DCREATE_DATE">
                                </R_DateTimePicker>
                            </R_ItemLayout>
                        </R_StackLayout>
                    </R_StackLayout>
                </R_ItemLayout>
            </R_StackLayout>
        </R_StackLayout>
        <R_StackLayout Row>
            <R_ItemLayout col="3" Class="mt-2">
                <R_AddButton Enabled="@(ViewModelFAT00301.llEnableAdd)"
                             R_Conductor="@_conTransEntry">
                </R_AddButton>

                <R_EditButton Enabled="@((ViewModelFAT00301.llEnableDelete && ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "00" ? true : false))"
                              R_Conductor="@_conTransEntry">
                </R_EditButton>

                <R_Button Enabled="@((ViewModelFAT00301.llEnableDelete && ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "00" ? true : false))"
                    OnClick="@DeleteTransactionEntry">
                    @Localizer["_btnDelete"]
                </R_Button>

@*                 <R_DeleteButton Enabled="@( ( ViewModelFAT00301.llEnableDelete &&
                                                                           ((ViewModelFAT00301.loTransEntry.CTRANS_STATUS != "99" || ViewModelFAT00301.loTransEntry.CTRANS_CODE != "98") &&
                                                                              !string.IsNullOrEmpty(ViewModelFAT00301.loTransEntry.CTRANS_STATUS)) ? true : false))"
                                R_Conductor="@_conTransEntry">
                </R_DeleteButton>
 *@
                @*                 <R_AddButton Enabled="@(ViewModelFAT00301.llEnableAdd && ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "99" ? false : true)"
                             R_Conductor="@_conTransEntry">
                </R_AddButton> *@

                @*                 <R_EditButton Enabled="@((_conTransEntry.R_ConductorMode == R_eConductorMode.Normal && ViewModelFAT00301.loTransEntry.CDEPT_CODE == "")
                                                                                                                                      || ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "99" || ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "01" ? false : true)"
                              R_Conductor="@_conTransEntry">
                </R_EditButton>

                <R_DeleteButton Enabled="@((_conTransEntry.R_ConductorMode == R_eConductorMode.Normal && ViewModelFAT00301.loTransEntry.CDEPT_CODE == "")
                                                                                                                                            || ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "99" || ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "01" ? false : true)"
                                R_Conductor="@_conTransEntry">
                </R_DeleteButton> *@

            </R_ItemLayout>

            <R_ItemLayout col="7" Class="mt-2">
                <R_Button OnClick="SubmitTrnasaction"
                          Enabled="@(ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "00" && llEnableSubmit ? true : false)">
                    @Localizer["_btnSubmit"]
                </R_Button>

                <R_Button OnClick="RedraftTransaction"  
                          Enabled="@(ViewModelFAT00301.loTransEntry.CTRANS_STATUS == "10" && llEnableRedraft  ? true : false)">
                    @Localizer["_btnRedraft"]
                </R_Button>

                <R_Popup Enabled="@((ViewModelFAT00301.llEnableJournal && 
                                   ViewModelFAT00301.Data.CTRANS_STATUS != "00" &&
                                   ViewModelFAT00301.Data.CGL_REF_NO != ""))"
                         R_Before_Open_Popup="@BeforeOpenJournal"
                         R_After_Open_Popup="@AfterOpenJournal">
                    @Localizer["_btnJournal"]
                </R_Popup>

            </R_ItemLayout>

            <R_ItemLayout auto="false" Class="mt-2">
                <R_CancelButton R_Conductor="@_conTransEntry">
                </R_CancelButton>

                <R_SaveButton R_Conductor="@_conTransEntry">
                </R_SaveButton>
            </R_ItemLayout>
        </R_StackLayout>
    </R_TabStripTab>

    <R_TabStripTab Title="@Localizer["_tabAssetInformation"]"
                   Enabled="ViewModelFAT00301.LENABLE_ASSET"
                   Id="FAT00302">

        <R_TabPage R_Before_Open_TabPage="@BeforeOpenAssetInformation"
                   R_After_Open_TabPage="@AfterOpenAssetInformation"
                   @ref="@_tabPageAssetInformationRef">

        </R_TabPage>

    </R_TabStripTab>
</R_TabStrip>

<R_Conductor R_ViewModel="@ViewModelFAT00301"
             @ref="@_conTransEntry"
             R_ServiceGetRecord="@GetTransactionEntryRecord"
             R_AfterAdd="@AfterAddTransEntry"
             R_SetOther="@SetOtherTransEntry"
             R_BeforeCancel="@BeforeCancelTransaction"
             R_Display="@DisplayTransactionEntry"
             R_Validation="@TransEntryValidation"
             R_Saving="@SavingTransactionEntry"
             R_ServiceSave="@SaveTransactionEntry"
             R_ServiceDelete="@DeleteTransactionEntry"
             R_IsHeader>


</R_Conductor>