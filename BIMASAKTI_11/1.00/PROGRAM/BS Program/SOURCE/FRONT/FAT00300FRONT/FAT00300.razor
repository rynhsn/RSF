@page "/FAT00300"
@inherits R_Page
@using FAT00300Common.Requests
@attribute [R_Page(Title = "Transaction List")]

<R_PredefinedDock Title="@Localizer["_pageTransEntry"]"
                  R_InstantiateDock="@BeforeOpenTabEntry"
                  R_AfterOpenPredefinedDock="@AfterOpenTabEntry">

</R_PredefinedDock>
<R_StackLayout>
    <R_StackLayout Row>
        @* Dept Code - Button Refresh *@
        <R_ItemLayout col="1">
            <R_Label>
                @Localizer["_gvDepartment"]
            </R_Label>
        </R_ItemLayout>

        <R_ItemLayout col="1">
            <R_TextBox Value="@viewModelFAT00300.Data.CDEPT_CODE"
                       OnLostFocused="@OnLostFocusedDepartment"
                       ValueChanged="@((string pcValue) => DeptCodeValueChanged(pcValue))">
            </R_TextBox>
        </R_ItemLayout>

        @* Lookup Department *@
        <R_Lookup R_Before_Open_Lookup="@BeforeOpenLookUpDepartment"
                  R_After_Open_Lookup="@AfterOpenLookUpDepartment">
            ...
        </R_Lookup>

        @* Dept Name *@
        <R_ItemLayout col="2">
            <R_TextBox Enabled="false"
                       Value="@viewModelFAT00300.Data.CDEPT_NAME">
            </R_TextBox>
        </R_ItemLayout>

        @* Input Period *@
        <R_ItemLayout col="5">
            <R_StackLayout Row>
                <R_ItemLayout col="2">
                    <R_Label>
                        @Localizer["_lblPeriodFrom"]
                    </R_Label>
                </R_ItemLayout>


                @* Year From *@
                <R_NumericTextBox Value="@viewModelFAT00300.IPERIOD_FROM"
                                  TValue="int"
                                  Min="viewModelFAT00300.PeriodRange.IMIN_YEAR"
                                  Max="viewModelFAT00300.PeriodRange.IMAX_YEAR"
                                  ValueChanged="@((int pcValue) => PeriodYearFromValueChanged(pcValue))"
                                  ThousandSeparator="false">
                </R_NumericTextBox>

                <R_DropDownList Data="@viewModelFAT00300.ListMonth"
                                TextField="@nameof(FAT00300PeriodDTO.CCODE)"
                                ValueField="@nameof(FAT00300PeriodDTO.CCODE)"
                                Value="@viewModelFAT00300.CFROM_PERIOD"
                                ValueChanged="@((string pcValue) => PeriodMonthFromValueChanged(pcValue))">
                </R_DropDownList>

                @* To *@
                <R_Label>
                    @Localizer["_lblTo"]
                </R_Label>
                <R_NumericTextBox Value="@viewModelFAT00300.IPERIOD_TO"
                                  TValue="int"
                                  Min="viewModelFAT00300.PeriodRange.IMIN_YEAR"
                                  Max="viewModelFAT00300.PeriodRange.IMAX_YEAR"
                                  ValueChanged="@((int pcValue) => PeriodYearToValueChanged(pcValue))"
                                  ThousandSeparator="false">
                </R_NumericTextBox>

                <R_DropDownList Data="@viewModelFAT00300.ListMonth"
                                TextField="@nameof(FAT00300PeriodDTO.CCODE)"
                                ValueField="@nameof(FAT00300PeriodDTO.CCODE)"
                                Value="@viewModelFAT00300.CTO_PERIOD"
                                ValueChanged="@((string pcValue) => PeriodMonthToValueChanged(pcValue))">
                </R_DropDownList>

                <R_Button OnClick="@GetTransListData">
                    @Localizer["_btnRefresh"]
                </R_Button>
            </R_StackLayout>
        </R_ItemLayout>

    </R_StackLayout>

    <R_StackLayout Row>
        @* Asset *@
        <R_ItemLayout col="1">
            <R_Label>
                @Localizer["_lblAssetCd"]
            </R_Label>
        </R_ItemLayout>

        <R_ItemLayout col="1">
            <R_TextBox Value="@viewModelFAT00300.Data.CASSET_CODE"
            OnLostFocused="@OnLostFocusedAsset"
                       ValueChanged="@((string pcValue) => AssetCodeValueChanged(pcValue))">
            </R_TextBox>
        </R_ItemLayout>

        <R_Lookup R_Before_Open_Lookup="@BeforeOpenLookUpAsset"
                  R_After_Open_Lookup="@AfterOpenLookUpAsset">
            ...
        </R_Lookup>

        <R_ItemLayout col="2">
            <R_TextBox 
                Enabled="false"
                Value="@viewModelFAT00300.Data.CASSET_NAME">
            </R_TextBox>
        </R_ItemLayout>
    </R_StackLayout>

    <R_Grid DataSource="@viewModelFAT00300.AllTransList"
            @ref="@gridTransList"
            R_ConductorGridSource="@conGridTrans"
            Pageable
            PageSize="20"
            Height="450px"
            R_GridType="R_eGridType.Original"
            R_Display="@GetTransListRecord"
            R_ServiceGetListRecord="@R_ServiceGetListTransaction">

        <R_GridColumns>
            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CDEPT_CODE)"
                              HeaderText="@Localizer["_gvDept"]"
                              Width="100px">
            </R_GridTextColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CREF_NO)"
                              HeaderText="@Localizer["_gvRefNo"]"
                              Width="150px">
            </R_GridTextColumn>

            <R_GridDatePickerColumn FieldName="@nameof(FAT00300GetTransListResultDTO.DREF_DATE)"
                                        HeaderText="@Localizer["_gvDate"]"
                                        Width="100px">
            </R_GridDatePickerColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CASSET_CODE)"
                              HeaderText="@Localizer["_lblAssetCd"]"
                              Width="150px">
            </R_GridTextColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CASSET_NAME)"
                              HeaderText="@Localizer["_lblAssetNm"]"
                              Width="200px">
            </R_GridTextColumn>

            <R_GridNumericColumn FieldName="@nameof(FAT00300GetTransListResultDTO.IQTY)"
                                 TValue="int"
                                 HeaderText="@Localizer["_gvDeprQty"]"
                                 Width="100px">
            </R_GridNumericColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CCURRENCY_CODE)"
                              HeaderText="@Localizer["_gvCurr"]"
                              Width="75px">
            </R_GridTextColumn>

            <R_GridNumericColumn FieldName="@nameof(FAT00300GetTransListResultDTO.NTRANS_AMOUNT)"
                                 TValue="decimal"
                                 HeaderText="@Localizer["_gvDeprAmount"]"
                                 Width="100px">
            </R_GridNumericColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CTRANS_STATUS_NAME)"
                              HeaderText="@Localizer["_gvStatus"]"
                              Width="125px">
            </R_GridTextColumn>

            <R_GridTextColumn FieldName="@nameof(FAT00300GetTransListResultDTO.CTRANS_DESC)"
                              HeaderText="@Localizer["_gvTransDesc"]"
                              Width="225px">
            </R_GridTextColumn>
        </R_GridColumns>
    </R_Grid>

</R_StackLayout>