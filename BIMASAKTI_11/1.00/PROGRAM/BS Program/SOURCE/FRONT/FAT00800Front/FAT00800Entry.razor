@page "/FAT00800Entry"
@using FAT00800FrontResources
@using R_BlazorFrontEnd.Interfaces
@using FAT00800Common.DTOs
@using R_BlazorFrontEnd.Enums
@inherits R_Page
@inject R_ILocalizer<Resources_Dummy_Class> _localizer

<R_TabStrip @ref="_tabMain" OnActiveTabIndexChanging="OnChangeTab">
    <R_TabStripTab @ref="_tabEntry" Id="@nameof(FAT00800Entry)" Title="@_localizer["_tabTransactionEntry"]">
        <R_StackLayout>
    <!-- Row 1: Department & Status -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblDepartment"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
             <R_TextBox @bind-Value="_VM.Data.CDEPT_CODE"
                       R_ConductorSource="_conductorRef"
                       OnLostFocused="OnLostFocusDept"
                       MaxLength="20"
                       R_EnableAdd="true"
                       R_EnableEdit="true" />
        </R_ItemLayout>
        <R_Lookup R_ConductorSource="_conductorRef"
                  R_Before_Open_Lookup="BeforeOpenLookupDept"
                  R_After_Open_Lookup="AfterOpenLookupDept"
                  R_EnableAdd="true"
                  R_EnableEdit="true">...</R_Lookup>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.Data.CDEPT_NAME" Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label FontColor="R_eFontColor.Danger">@_VM.Data.CTRANS_STATUS</R_Label>
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 2: Reference No & Ref Date -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblReferenceNo"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.Data.CREFERENCE_NO"
                       R_ConductorSource="_conductorRef"
                       Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
        </R_ItemLayout>
        <R_ItemLayout col="2" style="padding-left: 2.5rem !important;">
            <R_Label>@_localizer["_lblRefDate"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2" style="padding-left: 2.5rem !important;">
            <R_DatePicker @bind-Value="_VM.Data.DTRANSACTION_DATE"
                          R_ConductorSource="_conductorRef"
                          R_EnableAdd="true"
                          R_EnableEdit="true" />
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 3: Asset Code & Trans Seq No -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblAssetCode"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.Data.CASSET_CODE"
                       R_ConductorSource="_conductorRef"
                       OnLostFocused="OnLostFocusAsset"
                       MaxLength="20"
                       R_EnableAdd="true"
                       R_EnableEdit="true" />
        </R_ItemLayout>
        <R_Lookup R_ConductorSource="_conductorRef"
                  R_Before_Open_Lookup="BeforeOpenLookupAsset"
                  R_After_Open_Lookup="AfterOpenLookupAsset"
                  R_EnableAdd="true"
                  R_EnableEdit="true">...</R_Lookup>
        <R_ItemLayout col="1">
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblAssetTransSequence"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
                    <R_TextBox @bind-Value="_VM.Data.CASSET_TRANS_SEQ_NO" Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 4: Asset Name -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblAssetName"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.Data.CASSET_NAME" Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblAssetDepartment"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.CASSET_DEPT_CODE" Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.CASSET_DEPT_NAME" Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 5: Currency -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblCurrency"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
                    <R_ComboBox Value="@_VM.Data.CCURRENCY_CODE"
                                Data="@_VM.CurrencyList"
                                ValueField="@nameof(FAT00800Common.DTOs.FAT00800GetCurrencyListResultDTO.CCURRENCY_CODE)"
                                TextField="@nameof(FAT00800Common.DTOs.FAT00800GetCurrencyListResultDTO.CCURRENCY_NAME)"
                                R_ConductorSource="@_conductorRef"
                                R_EnableAdd="true"
                                R_EnableEdit="true" />
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 7: Currency Rate - Local -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblCurrencyRate"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblLocalCurrency"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NLBASE_RATE"
                                TValue="decimal"
                                Decimals="6"
                                ThousandSeparator="true"
                                R_ConductorSource="_conductorRef"
                                Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.Data.CCURRENCY_CODE</R_Label>
        </R_ItemLayout>
        <R_ItemLayout auto="true">
            <R_Label>=</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NLCURRENCY_RATE"
                                TValue="decimal"
                                Decimals="6"
                                ThousandSeparator="true"
                                R_ConductorSource="_conductorRef"
                                Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.CompanyInfoData.CLOCAL_CURRENCY_CODE</R_Label>
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 8: Currency Rate - Base -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2"></R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblBaseCurrency"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NBBASE_RATE"
                                TValue="decimal"
                                Decimals="0"
                                ThousandSeparator="true"
                                R_ConductorSource="_conductorRef"
                                Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.Data.CCURRENCY_CODE</R_Label>
        </R_ItemLayout>
        <R_ItemLayout auto="true">
            <R_Label>=</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NBCURRENCY_RATE"
                                TValue="decimal"
                                Decimals="2"
                                R_ConductorSource="_conductorRef"
                                Enabled="@(_conductorRef?.R_ConductorMode != R_eConductorMode.Normal && _VM.Data.CCURRENCY_CODE != _VM.CompanyInfoData.CLOCAL_CURRENCY_CODE)" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.CompanyInfoData.CLOCAL_CURRENCY_CODE</R_Label>
        </R_ItemLayout>
    </R_StackLayout>
    <R_StackLayout Row Class="mb-1">
                <R_ItemLayout col="2">
                </R_ItemLayout>
                <R_ItemLayout col="3">
                </R_ItemLayout>
                <R_ItemLayout col="3">
                    <R_Label>@_localizer["_lblLocalAmount"]*</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="3">
                    <R_Label>@_localizer["_lblBaseAmount"]*</R_Label>
                </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 6: Sale Amount -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblSaleAmount"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
            <R_Label>@_VM.Data.CCURRENCY_CODE</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
                    <R_NumericTextBox Value="_VM.Data.NTRANS_AMOUNT"
                              TValue="decimal"
                              Decimals="2"
                              ThousandSeparator="true"
                              R_ConductorSource="_conductorRef"
                              R_EnableAdd="true"
                              R_EnableEdit="true"
                              OnChanged="OnSaleAmountChanged"
                              OnLostFocused="OnSaleAmountLostFocus" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.CompanyInfoData.CLOCAL_CURRENCY_CODE</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NLTRANS_AMOUNT"
                                TValue="decimal"
                                Decimals="6"
                                ThousandSeparator="true"
                                Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_Label>@_VM.CompanyInfoData.CLOCAL_CURRENCY_CODE</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
                    <R_NumericTextBox @bind-Value="_VM.Data.NBTRANS_AMOUNT"
                                TValue="decimal"
                                Decimals="6"
                                ThousandSeparator="true"
                                Enabled="false" />
        </R_ItemLayout>
                


    </R_StackLayout>

            @* next Book Value =======================================================================================================================*@

    <!-- Row 9: Sale Amount (Local & Base) -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblLocalAmount"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
            <R_NumericTextBox @bind-Value="_VM.Data.NLTRANSACTION_AMOUNT1"
                              TValue="decimal"
                              Decimals="2"
                              ThousandSeparator="true"
                              Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
            <R_TextBox @bind-Value="_VM.loCurrencyTemp" Enabled="false" />
        </R_ItemLayout>
        
    </R_StackLayout>

    <!-- Row 10: Book Value -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblBaseAmount"]</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="1">
            <R_NumericTextBox @bind-Value="_VM.Data.NBTRANSACTION_AMOUNT1"
                              TValue="decimal"
                              Decimals="2"
                              ThousandSeparator="true"
                              Enabled="false" />
        </R_ItemLayout>
        <R_ItemLayout col="1">
            <R_TextBox @bind-Value="_VM.loCurrencyTemp" Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    
    <!-- Row 12: Allocation -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblAllocation"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="2">
            <R_TextBox @bind-Value="_VM.Data.CALLOC_EXPENSE_CODE"
                       R_ConductorSource="_conductorRef"
                       OnLostFocused="OnLostFocusAlloc"
                       MaxLength="20"
                       R_EnableAdd="true"
                       R_EnableEdit="true" />
        </R_ItemLayout>
        <R_Lookup R_ConductorSource="_conductorRef"
                  R_Before_Open_Lookup="BeforeOpenLookupAlloc"
                  R_After_Open_Lookup="AfterOpenLookupAlloc"
                  R_EnableAdd="true"
                  R_EnableEdit="true">...</R_Lookup>
        <R_ItemLayout col="4">
            <R_TextBox @bind-Value="_lcAllocDesc" Enabled="false" />
        </R_ItemLayout>
    </R_StackLayout>

    <!-- Row 13: Description -->
    <R_StackLayout Row Class="mb-1">
        <R_ItemLayout col="2">
            <R_Label>@_localizer["_lblDescription"]*</R_Label>
        </R_ItemLayout>
        <R_ItemLayout col="6">
            <R_StackLayout Row>
                <R_ItemLayout col="10">
                            <R_TextArea @bind-Value="_VM.Data.CTRANS_DESC"
                        R_ConductorSource="_conductorRef"
                        R_EnableAdd="true"
                        R_EnableEdit="true" />
                </R_ItemLayout>
            </R_StackLayout>
        </R_ItemLayout>
    <R_ItemLayout col="4">
        <R_StackLayout>
            <R_StackLayout Row Class="mb-1">
                <R_ItemLayout col="3">
                    <R_Label Style="text-align:right">Updated By</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="5">
                    <R_TextBox @bind-Value="_VM.Data.CUPDATE_BY" Enabled="false" />
                </R_ItemLayout>
                <R_ItemLayout col="4">
                    <R_TextBox @bind-Value="_lcUpdateDate" Enabled="false" />
                </R_ItemLayout>
            </R_StackLayout>
            <R_StackLayout Row Class="mb-1">
                <R_ItemLayout col="3">
                    <R_Label Style="text-align:right">Created By</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="5">
                    <R_TextBox @bind-Value="_VM.Data.CCREATE_BY" Enabled="false" />
                </R_ItemLayout>
                <R_ItemLayout col="4">
                    <R_TextBox @bind-Value="_lcCreateDate" Enabled="false" />
                </R_ItemLayout>
            </R_StackLayout>
        </R_StackLayout>
    </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row="true" Spacing="5" Class="justify-content-between">
    <R_StackLayout Row>
        <R_ItemLayout>
            <R_AddButton R_Conductor="_conductorRef" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_EditButton R_Conductor="_conductorRef" Enabled="@_VM.LenableEdit" />
        </R_ItemLayout>
        <R_ItemLayout>
            <R_DeleteButton R_Conductor="_conductorRef" />
        </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row>
        <R_ItemLayout>
            <R_Button R_ConductorSource="_conductorRef"
                      R_EnableOther="true"
                      Enabled="@(_conductorRef?.R_ConductorMode is R_eConductorMode.Normal && !string.IsNullOrEmpty(_VM.Data.CREFERENCE_NO) && _VM.Data.CSTATUS == "00")"
                      OnClick="OnClickSubmit">
                @_localizer["btnSubmit"]
            </R_Button>
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button R_ConductorSource="_conductorRef"
                      R_EnableOther="true"
                      Enabled="@(_conductorRef?.R_ConductorMode is R_eConductorMode.Normal && !string.IsNullOrEmpty(_VM.Data.CREFERENCE_NO) && _VM.Data.CSTATUS == "01")"
                      OnClick="OnClickDraft">
                @_localizer["btnDraft"]
            </R_Button>
        </R_ItemLayout>
        <R_ItemLayout>
            <R_Button R_ConductorSource="_conductorRef"
                      R_EnableOther="true"
                      Enabled="@(!string.IsNullOrEmpty(_VM.Data.CREFERENCE_NO) && _VM.Data.CSTATUS == "08")"
                      OnClick="OnClickJournal">
                @_localizer["btnJournal"]
            </R_Button>
        </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row>
        <R_ItemLayout>
            <R_CancelButton R_Conductor="_conductorRef" />
        </R_ItemLayout>
        <R_ItemLayout Class="me-2">
            <R_SaveButton R_Conductor="_conductorRef" />
        </R_ItemLayout>
    </R_StackLayout>
        </R_StackLayout>
        </R_StackLayout>
    </R_TabStripTab>

    <R_TabStripTab @ref="_tabAssetInfo" Id="@nameof(FAT00800AssetInformation)" Title="@_localizer["_lblAssetInfo"]" Enabled="@(!string.IsNullOrEmpty(_VM.Data?.CREFERENCE_NO) && !string.IsNullOrEmpty(_VM.Data?.CASSET_CODE))">
        <R_TabPage @ref="_pageAssetInfo" R_Before_Open_TabPage="BeforeOpenAssetInfoTab" R_TabEventCallback="AssetInfoTabEventCallBack"/>
    </R_TabStripTab>
</R_TabStrip>

<R_Conductor @ref="_conductorRef"
             R_ViewModel="_VM"
             R_IsHeader="true"
             R_ServiceGetRecord="ServiceGetRecord"
             R_CheckAdd="CheckAdd"
             R_CheckEdit="CheckEdit"
             R_Display="Display"
             R_CheckDelete="CheckDelete"
             R_AfterAdd="AfterAdd"
             R_Validation="Validation"
             R_Saving="Saving"
             R_ServiceSave="ServiceSave"
             R_DisableDeleteConfirmation="true"
             R_BeforeDelete="BeforeDelete"
             R_ServiceDelete="ServiceDelete"
             R_SetOther="SetOther" />
