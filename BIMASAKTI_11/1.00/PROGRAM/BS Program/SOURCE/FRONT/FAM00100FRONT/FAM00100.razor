@page "/FAM00100"
@inherits R_Page
@attribute [R_Page(ResourceId = "_FASystemParameter")]

<R_StackLayout Row>
    <R_ItemLayout col="7">
        <R_StackLayout>
            <R_StackLayout Row>
                <R_ItemLayout col="5">
                    <R_Label>@_localizer["_CurrRateTypeNotMand"]*</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_TextBox MaxLength="4" R_ConductorSource="_conductorRef" @ref="_CurrencyRateType" @bind-Value="@_viewModel.Data.CRATETYPE_CODE" R_EnableEdit OnLostFocused="@CurrencyRateType_OnLostFocus"></R_TextBox>
                </R_ItemLayout>
                <R_ItemLayout col="0">
                    <R_Lookup R_ConductorSource="_conductorRef"
                              R_Before_Open_Lookup="@R_Before_Open_LookupCurrRateType"
                              R_After_Open_Lookup="@R_After_Open_LookupCurrRateType" R_EnableEdit>...</R_Lookup>
                </R_ItemLayout>
                <R_ItemLayout col="4">
                    <R_TextBox @bind-Value="@_viewModel.Data.CRATETYPE_DESCRIPTION"
                               Enabled="false"></R_TextBox>
                </R_ItemLayout>
            </R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout col="5">
                    <R_Label>@_localizer["_DefaultTransDeptNotMand"]*</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_TextBox MaxLength="4" R_ConductorSource="_conductorRef" @bind-Value="@_viewModel.Data.CTRANS_DEPT_CODE" R_EnableEdit OnLostFocus="@TransDept_OnLostFocus"></R_TextBox>
                </R_ItemLayout>
                <R_ItemLayout col="0">
                    <R_Lookup R_ConductorSource="_conductorRef"
                              R_Before_Open_Lookup="@R_Before_Open_LookupTransDept"
                              R_After_Open_Lookup="@R_After_Open_LookupTransDept" R_EnableEdit>...</R_Lookup>
                </R_ItemLayout>
                <R_ItemLayout col="4">
                    <R_TextBox @bind-Value="@_viewModel.Data.CTRANS_DEPT_NAME"
                               Enabled="false"></R_TextBox>
                </R_ItemLayout>
            </R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout col="5">
                    <R_Label>@_localizer["_DefaultAssetDeptNotMand"]</R_Label>
                </R_ItemLayout>
                <R_ItemLayout col="2">
                    <R_TextBox MaxLength="4" R_ConductorSource="_conductorRef" @bind-Value="@_viewModel.Data.CASSET_DEPT_CODE" R_EnableEdit OnLostFocus="@DefaultAsset_OnLostFocus"></R_TextBox>
                </R_ItemLayout>
                <R_ItemLayout col="0">
                    <R_Lookup R_ConductorSource="_conductorRef" R_Before_Open_Lookup="@R_Before_Open_LookupDefaultAsset"
                              R_After_Open_Lookup="@R_After_Open_LookupDefaultAsset" R_EnableEdit>...</R_Lookup>
                </R_ItemLayout>
                <R_ItemLayout col="4">
                    <R_TextBox @bind-Value="@_viewModel.Data.CASSET_DEPT_NAME"
                               Enabled="false"></R_TextBox>
                </R_ItemLayout>
            </R_StackLayout>

            <R_StackLayout Row>
                <R_ItemLayout col="5">
                    <R_StackLayout>
                        <R_ItemLayout col="5">
                            <R_Label>@_localizer["_JournalType"]</R_Label>
                        </R_ItemLayout>
                        <R_ItemLayout col="2">
                        </R_ItemLayout>
                        <R_ItemLayout col="0">
                            <R_RadioGroup Data="@_viewModel.CJOURNAL_TYPE_LIST"
                                          R_ConductorSource="_conductorRef"
                                          @bind-Value="_viewModel.Data.CASSET_JOURNAL_TYPE"
                                          Layout="R_eRadioGroupLayout.Vertical"
                                          TextField="Value"
                                          R_EnableEdit
                                          ValueField="Key"></R_RadioGroup>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_ItemLayout>

                <R_StackLayout>
                    <R_ItemLayout col="12">
                        <R_Label>@_localizer["_AutoDepreciationTrans"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_RadioGroup Data="@_viewModel.CAUTO_DEPT_TYPE_LIST"
                                      R_ConductorSource="_conductorRef"
                                      R_EnableEdit
                                      @bind-Value="_viewModel.Data.CAUTO_DEPR_TYPE"
                                      Layout="R_eRadioGroupLayout.Vertical"
                                      TextField="Value"
                                      ValueField="Key"></R_RadioGroup>
                    </R_ItemLayout>
                </R_StackLayout>
            </R_StackLayout>
        </R_StackLayout>
    </R_ItemLayout>

    <R_ItemLayout col="5" >
        <R_GroupBox Title="@_localizer["_Period"]" TitleClass="text-danger"  Class="p-2">
            <R_StackLayout Class="FAM01100Main_r_groupbox">
                    <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.Data.LICLINK"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableEdit></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_ICLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="7">
                        <R_DatePicker @bind-Value="@_viewModel.ICLinkDate"
                                      Enabled="@(_viewModel.Data.LICLINK && _conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit)"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.Data.LPJLINK"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableEdit></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_PJLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="7">
                        <R_DatePicker @bind-Value="@_viewModel.PJLinkDate"
                                      Enabled="@(_viewModel.Data.LPJLINK && _conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit)"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.Data.LGLLINK"
                                    R_ConductorSource="@_conductorRef"
                                    R_EnableEdit></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_GLLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="7">
                        <R_DatePicker @bind-Value="@_viewModel.GLLinkDate"
                                      Enabled="@(_viewModel.Data.LGLLINK && _conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit)"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_CurrentPeriod"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_ComboBox Data="@_viewModel.PeriodMonthList"
                                    Value="_viewModel.Data.CCURRENT_PERIOD_MM"
                                    PopupMaxHeight="140px"
                                    ValueField="Key"
                                    TextField="Value"
                                    ValueChanged="(string value) => OnChangePeriodMonth(value)"
                                    R_ConductorSource="_conductorRef"
                                    R_EnableEdit />

                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox Value="@_viewModel.Data.CCURRENT_PERIOD_YY_INT"
                                          Max="@_viewModel.GSPeriodYearRange.IMAX_YEAR"
                                          Min="@_viewModel.GSPeriodYearRange.IMIN_YEAR"
                                          ThousandSeparator="false"
                                          Step="1"
                                          ValueChanged="(int value) => OnChangePeriodYear(value)"
                                          R_ConductorSource="_conductorRef"
                                          R_EnableEdit></R_NumericTextBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_Label>@_localizer["_By"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_viewModel.Data.CLPRD_END_BY" Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_SoftClosePeriod"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_ComboBox Data="@_viewModel.PeriodMonthList"
                                    Value="_viewModel.Data.CSOFT_PERIOD_MM"
                                    PopupMaxHeight="140px"
                                    ValueField="Key"
                                    TextField="Value"
                                    ValueChanged="(string value) => OnChangeSoftPeriodMonth(value)"
                                    R_ConductorSource="_conductorRef" />
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox Value="@_viewModel.Data.CSOFT_PERIOD_YY_INT"
                                          Max="@_viewModel.GSPeriodYearRange.IMAX_YEAR"
                                          Min="@_viewModel.GSPeriodYearRange.IMIN_YEAR"
                                          ThousandSeparator="false"
                                          ValueChanged="(int value) => OnChangeSoftPeriodYear(value)"
                                          R_ConductorSource="_conductorRef"></R_NumericTextBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_Label>@_localizer["_By"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_viewModel.Data.CLSOFT_END_BY" Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="_viewModel.Data.LSOFT_CLOSING_FLAG" Enabled="false"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="6" Class="me-5">
                        <R_Label>@_localizer["_SoftClosingProgress"]</R_Label>
                    </R_ItemLayout>

                    <R_ItemLayout col="0">
                        <R_Label>@_localizer["_By"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox @bind-Value="_viewModel.Data.CSOFT_CLOSING_BY" Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>
            </R_StackLayout>
            
        </R_GroupBox>
    </R_ItemLayout>
</R_StackLayout>

<R_StackLayout Row Class="mt-2">
    <R_ItemLayout col="5">
        <R_StackLayout Row Class="mt-1">
            <R_ItemLayout col="0">
                <R_CheckBox Value="@_viewModel.Data.LINCREMENT_FLAG" ValueChanged="@((bool value) => OnIncrementalChanged(value))" R_ConductorSource="_conductorRef" R_EnableEdit></R_CheckBox>
            </R_ItemLayout>
            <R_ItemLayout col="12">
                <R_Label>@_localizer["_IncrementalAssetCode"]</R_Label>
            </R_ItemLayout>
        </R_StackLayout>
        <R_StackLayout Row Class="mt-1 ms-4">
            <R_ItemLayout col="0">
                <R_CheckBox @bind-Value="@_viewModel.Data.LBY_DEPT" R_ConductorSource="_conductorRef"
                            Enabled="@(_viewModel.Data.LINCREMENT_FLAG &&_conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit && _viewModel.Data.LINCREMENT_FLAG)"></R_CheckBox>
            </R_ItemLayout>
            <R_ItemLayout col="12">
                <R_Label>@_localizer["_ByDept"]</R_Label>
            </R_ItemLayout>
        </R_StackLayout>
    </R_ItemLayout>
    <R_ItemLayout col="6">
        <R_StackLayout Row Class="mt-1">
            <R_ItemLayout col="2">
                <R_Label>@_localizer["_length"]</R_Label>
            </R_ItemLayout>
            <R_ItemLayout col="2" >
                <R_NumericTextBox @bind-Value="@_viewModel.Data.IJRNGRP_LENGTH"
                                    R_ConductorSource="_conductorRef"
                                    Enabled="@(_viewModel.Data.LINCREMENT_FLAG && _conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit)"
                                    Min="1"
                                    Max="5"></R_NumericTextBox>
            </R_ItemLayout>
        </R_StackLayout>
        <R_StackLayout Row Class="mt-1">
            <R_ItemLayout col="2">
                <R_Label>@_localizer["_length"]</R_Label>
            </R_ItemLayout>
            <R_ItemLayout col="2">
                <R_NumericTextBox @bind-Value="@_viewModel.Data.IBY_DEPT_LENGTH"
                                    Min="1"
                                    Max="5"
                                    R_ConductorSource="_conductorRef"
                                    Enabled="@(_viewModel.Data.LBY_DEPT && _viewModel.Data.LINCREMENT_FLAG &&  _conductorRef.R_ConductorMode == R_BlazorFrontEnd.Enums.R_eConductorMode.Edit)"></R_NumericTextBox>
            </R_ItemLayout>
        </R_StackLayout>
    </R_ItemLayout>
</R_StackLayout>

@* <R_StackLayout Row Class="mt-1"> *@
    
    
@* </R_StackLayout> *@

@* <R_StackLayout Row Class="ms-5"> *@
    
    
@* </R_StackLayout> *@


<R_StackLayout Row Justify="@R_eJustify.FlexEnd">
    <R_ItemLayout col="0">
        <R_Label>@_localizer["_UpdatedBy"]</R_Label>
    </R_ItemLayout>
    <R_ItemLayout col="1">
        <R_TextBox @bind-Value="@_viewModel.Data.CUPDATE_BY" Enabled="false"></R_TextBox>
    </R_ItemLayout>
    <R_ItemLayout col="2">
        <R_DateTimePicker @bind-Value="@_viewModel.Data.DUPDATE_DATE" ShowPickerButton="false"
                          Enabled="false"></R_DateTimePicker>
    </R_ItemLayout>
</R_StackLayout>
<R_StackLayout Row Justify="@R_eJustify.FlexEnd">
    <R_ItemLayout col="0">
        <R_Label>@_localizer["_CreatedBy"]</R_Label>
    </R_ItemLayout>
    <R_ItemLayout col="1">
        <R_TextBox @bind-Value="@_viewModel.Data.CCREATE_BY" Enabled="false"></R_TextBox>
    </R_ItemLayout>
    <R_ItemLayout col="2">
        <R_DateTimePicker @bind-Value="@_viewModel.Data.DCREATE_DATE" ShowPickerButton="false"
                          Enabled="false"></R_DateTimePicker>
    </R_ItemLayout>
</R_StackLayout>

<R_StackLayout Row Justify="@R_eJustify.SpaceBetween" Class="mt-2">
    <R_ItemLayout>
        <R_EditButton R_Conductor="_conductorRef"></R_EditButton>
    </R_ItemLayout>
    <R_ItemLayout>
        <R_CancelButton R_Conductor="_conductorRef"></R_CancelButton>
        <R_SaveButton R_Conductor="_conductorRef"></R_SaveButton>
    </R_ItemLayout>
</R_StackLayout>

<R_Conductor @ref="@_conductorRef"
             R_ViewModel="@_viewModel"
             R_IsHeader="true"
             R_ServiceGetRecord="@SystemParamCB_ServiceGetRecord"
             R_Validation="@SystemParamCB_Validation"
             R_ServiceSave="@SystemParamCB_ServiceSave"
             R_DisableCancelConfirmation
             R_BeforeCancel="SystemParamCB_BeforeCancel"
             R_Display="@SystemParamCB_Display" />

<style>
    .FAM01100Main_r_groupbox {
        padding-left: 4px;
        padding-right: 5px;
    }
</style>