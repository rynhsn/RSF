@inherits R_Page
@attribute [R_Page(ResourceId = "_FASystemParameter")]

<R_StackLayout Style="width: 1000px">

    <R_StackLayout Row>
        <R_ItemLayout>
            <R_Label FontColor="R_eFontColor.Primary" FontStyle="R_eFontStyle.Bold" FontSize="20px">@_localizer["_L01"]</R_Label>
        </R_ItemLayout>
    </R_StackLayout>

    <R_StackLayout Row>
        <R_ItemLayout col="6">
            <R_StackLayout>
                <R_StackLayout Row>
                    <R_ItemLayout col="5">
                        <R_Label>@_localizer["_CurrRateType"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox MaxLength="4" @ref="_CurrencyRateType" @bind-Value="@_viewModel.SystemParameterFA.CRATETYPE_CODE" Enabled="true" OnLostFocus="@CurrencyRateType_OnLostFocus"></R_TextBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_Lookup R_Before_Open_Lookup="@R_Before_Open_LookupCurrRateType"
                                  R_After_Open_Lookup="@R_After_Open_LookupCurrRateType" Enabled="true">...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_TextBox @bind-Value="@_viewModel.SystemParameterFA.CRATETYPE_DESCRIPTION"
                                   Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="5">
                        <R_Label>@_localizer["_DefaultTransDept"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox MaxLength="4" @ref="_CurrencyRateType" @bind-Value="@_viewModel.SystemParameterFA.CTRANS_DEPT_CODE" Enabled="true" OnLostFocus="@TransDept_OnLostFocus"></R_TextBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_Lookup R_Before_Open_Lookup="@R_Before_Open_LookupTransDept"
                                  R_After_Open_Lookup="@R_After_Open_LookupTransDept" Enabled="true">...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_TextBox @bind-Value="@_viewModel.SystemParameterFA.CTRANS_DEPT_NAME"
                                   Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="5">
                        <R_Label>@_localizer["_DefaultAssetDept"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_TextBox MaxLength="4" @ref="_CurrencyRateType" @bind-Value="@_viewModel.SystemParameterFA.CASSET_DEPT_CODE" Enabled="true" OnLostFocus="@DefaultAsset_OnLostFocus"></R_TextBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="0">
                        <R_Lookup R_Before_Open_Lookup="@R_Before_Open_LookupDefaultAsset"
                                  R_After_Open_Lookup="@R_After_Open_LookupDefaultAsset" Enabled="true">...</R_Lookup>
                    </R_ItemLayout>
                    <R_ItemLayout col="4">
                        <R_TextBox @bind-Value="@_viewModel.SystemParameterFA.CASSET_DEPT_NAME"
                                   Enabled="false"></R_TextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="5">
                        <R_StackLayout>
                            <R_ItemLayout col="5">
                                <R_Label>@_localizer["_JournalType"]</R_Label>
                            </R_ItemLayout>
                            <R_ItemLayout col="2">
                            </R_ItemLayout>
                            <R_ItemLayout col="0">
                                <R_RadioGroup Data="@_viewModel.CJOURNAL_TYPE_LIST"
                                              @bind-Value="_viewModel.SystemParameterFA.CASSET_JOURNAL_TYPE"
                                              Layout="R_eRadioGroupLayout.Vertical"
                                              TextField="Value"
                                              ValueField="Key"></R_RadioGroup>
                            </R_ItemLayout>
                        </R_StackLayout>
                    </R_ItemLayout>

                    <R_StackLayout>
                        <R_ItemLayout col="12">
                            <R_Label>@_localizer["_AutoDepreciationTrans"]</R_Label>
                        </R_ItemLayout>
                        <R_ItemLayout col="2">
                        </R_ItemLayout>
                        <R_ItemLayout col="0">
                            <R_RadioGroup Data="@_viewModel.CAUTO_DEPR_TYPE_LIST"
                                          @bind-Value="_viewModel.SystemParameterFA.CAUTO_DEPR_TYPE"
                                          Layout="R_eRadioGroupLayout.Vertical"
                                          TextField="Value"
                                          ValueField="Key"></R_RadioGroup>
                        </R_ItemLayout>
                    </R_StackLayout>
                </R_StackLayout>
                
                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="_viewModel.SystemParameterFA.LINCREMENT_FLAG"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="8">
                        <R_Label>@_localizer["_IncrementalAssetCode"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="1"></R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_Label>@_localizer["_length"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox
                            @bind-Value="@_viewModel.SystemParameterFA.IJRNGRP_LENGTH"
                            Min="1"
                            Max="5"
                                          Enabled="@_viewModel.SystemParameterFA.LINCREMENT_FLAG"></R_NumericTextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row Class="ms-5">
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.SystemParameterFA.LBY_DEPT" Enabled="@_viewModel.SystemParameterFA.LINCREMENT_FLAG"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="8">
                        <R_Label>@_localizer["_ByDept"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="1"></R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_Label>@_localizer["_length"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_NumericTextBox
                            @bind-Value="@_viewModel.SystemParameterFA.IBY_DEPT_LENGTH"
                            Min="1"
                            Max="5"
                            Enabled="@_viewModel.SystemParameterFA.LBY_DEPT"></R_NumericTextBox>
                    </R_ItemLayout>
                </R_StackLayout>

            </R_StackLayout>
        </R_ItemLayout>

        <R_ItemLayout col="6" Class="p-2">
            <R_GroupBox Title="@_localizer["_Period"]" TitleClass="text-danger">
                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.SystemParameterFA.LICLINK"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_Label>@_localizer["_ICLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="5">
                        <R_DatePicker @bind-Value="@_viewModel.ICLinkDate"
                                      Enabled="@_viewModel.SystemParameterFA.LICLINK"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.SystemParameterFA.LPJLINK"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_Label>@_localizer["_PJLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="5">
                        <R_DatePicker @bind-Value="@_viewModel.PJLinkDate"
                                      Enabled="@_viewModel.SystemParameterFA.LPJLINK"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="0">
                        <R_CheckBox @bind-Value="@_viewModel.SystemParameterFA.LGLLINK"></R_CheckBox>
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_Label>@_localizer["_GLLinkDate"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="5">
                        <R_DatePicker @bind-Value="@_viewModel.GLLinkDate"
                                      Enabled="@_viewModel.SystemParameterFA.LGLLINK"></R_DatePicker>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_CurrentPeriod"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_ComboBox Data="@_viewModel.PeriodMonthList"
                                    @bind-Value="_viewModel.SystemParameterFA.CCURRENT_PERIOD_MM"
                                    PopupMaxHeight="140px"
                                    ValueField="Key"
                                    TextField="Value"
                                    Enabled="true" />

                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox @bind-Value="@_viewModel.SystemParameterFA.CCURRENT_PERIOD_YY_INT"
                                          Max="@_viewModel.GSPeriodYearRange.IMAX_YEAR"
                                          Min="@_viewModel.GSPeriodYearRange.IMIN_YEAR"
                                          ThousandSeparator="false"
                                          Enabled="true"></R_NumericTextBox>
                    </R_ItemLayout>
                </R_StackLayout>

                <R_StackLayout Row>
                    <R_ItemLayout col="4">
                        <R_Label>@_localizer["_SoftClosePeriod"]</R_Label>
                    </R_ItemLayout>
                    <R_ItemLayout col="2">
                        <R_ComboBox Data="@_viewModel.PeriodMonthList"
                                    @bind-Value="_viewModel.SystemParameterFA.CSOFT_PERIOD_MM"
                                    PopupMaxHeight="140px"
                                    ValueField="Key"
                                    TextField="Value"
                                    Enabled="true" />
                    </R_ItemLayout>
                    <R_ItemLayout col="3">
                        <R_NumericTextBox @bind-Value="@_viewModel.SystemParameterFA.CSOFT_PERIOD_YY_INT"
                                          Max="@_viewModel.GSPeriodYearRange.IMAX_YEAR"
                                          Min="@_viewModel.GSPeriodYearRange.IMIN_YEAR"
                                          ThousandSeparator="false"
                                          Enabled="true"></R_NumericTextBox>
                    </R_ItemLayout>
                </R_StackLayout>
            </R_GroupBox>
        </R_ItemLayout>
    </R_StackLayout>
</R_StackLayout>

<R_StackLayout Row Class="mt-2">
    <R_ItemLayout>
        <R_Button OnClick="BtnCreate_OnClick">@_localizer["_BtnCreate"]</R_Button>
        <R_Button OnClick="BtnCancel_OnClick">@_localizer["_BtnCancel"]</R_Button>
    </R_ItemLayout>
</R_StackLayout>
